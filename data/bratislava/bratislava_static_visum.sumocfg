<?xml version="1.0" encoding="UTF-8"?>

<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

    <input>
        <net-file value="net/bratislava_static.net.xml"/>
        <route-files value="routes/bratislava_visum.rou.xml"/>
    </input>

    <time>
        <begin value="21600"/>
        <end value="43200"/>
        <step-length value="1"/>
    </time>

    <output>
        <tripinfo-output value="sim/bratislava_visum.tripinfo.xml"/>
        <tripinfo-output.write-unfinished value="true"/>
        <statistic-output value="sim/bratislava_visum.stats.xml"/>
        <summary-output value="sim/bratislava_visum.summary.xml"/>
    </output>

    <processing>
        <time-to-teleport value="300"/>
        <ignore-junction-blocker value="1"/>
        <no-internal-links value="true"/>
        <scale value="0.2"/>
    </processing>

    <routing>
        <device.rerouting.probability value="0.25"/>
        <device.rerouting.period value="300"/>
        <device.rerouting.adaptation-interval value="10"/>
    </routing>

    <report>
        <no-step-log value="true"/>
        <duration-log.statistics value="true"/>
    </report>

</configuration>
