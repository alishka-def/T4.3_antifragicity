<?xml version="1.0" encoding="UTF-8"?>

<!-- Bratislava SUMO scenario.
     Run from the repository root with:
         sumo-gui -c data/bratislava/bratislava.sumocfg
     or headless with:
         sumo -c data/bratislava/bratislava.sumocfg
     Paths below are relative to THIS file (data/bratislava/).
     NOTE: net / routes / poly are produced by the build steps; this config
     will run once those files exist. -->
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

    <input>
        <net-file value="net/bratislava.net.xml"/>
        <route-files value="routes/bratislava.rou.xml"/>
        <additional-files value="zones/bratislava_zones.poly.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="86400"/>
        <step-length value="1"/>
    </time>

    <processing>
        <!-- Teleport vehicles stuck for >5 min so the sim doesn't gridlock. -->
        <time-to-teleport value="300"/>
    </processing>

    <report>
        <no-step-log value="true"/>
        <duration-log.statistics value="true"/>
    </report>

</configuration>
