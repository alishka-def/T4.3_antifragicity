<?xml version="1.0" encoding="UTF-8"?>

<!-- Odessa SUMO scenario.
     Run from the repository root with:
         sumo-gui -c data/odessa/odessa.sumocfg
     or headless with:
         sumo -c data/odessa/odessa.sumocfg
     Paths below are relative to THIS file (data/odessa/).
     NOTE: net / routes / poly are produced by the build steps; this config
     will run once those files exist. -->
<!-- PEAK scenario: morning peak 06:00-11:00 (begin 21600s, end 39600s).
     Uses peak-only routes (od hours 6-10). Raise <end> to let late trips finish.
     Traffic lights: STATIC (fixed-time). Point net-file back to
     net/odessa.net.xml for the original actuated signals. -->
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

    <input>
        <net-file value="net/odessa_static.net.xml"/>
        <route-files value="routes/odessa_peak.rou.xml"/>
    </input>

    <time>
        <begin value="21600"/>
        <end value="39600"/>
        <step-length value="1"/>
    </time>

    <processing>
        <!-- No teleporting: keep honest congestion (no teleport artifacts in the
             delay/speed stats). Deadlock is avoided instead by no-internal-links
             (removes in-junction blocking) + ignore-junction-blocker. -->
        <time-to-teleport value="-1"/>
        <ignore-junction-blocker value="1"/>
        <no-internal-links value="true"/>
    </processing>

    <routing>
        <!-- In-sim (dynamic) rerouting: every vehicle periodically re-routes
             around congestion using measured edge travel times, instead of
             keeping its fixed one-shot duarouter path. Spreads flow across
             parallel routes and prevents corridor gridlock. -->
        <device.rerouting.probability value="1"/>
        <device.rerouting.period value="300"/>
        <device.rerouting.adaptation-interval value="10"/>
    </routing>

    <report>
        <no-step-log value="true"/>
        <duration-log.statistics value="true"/>
    </report>

</configuration>
